<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal: everything the SDK needs — the download service, the
  voice-session service, and the INTERNET / FOREGROUND_SERVICE / POST_NOTIFICATIONS
  permissions — merges in from the SDK's own manifest. This app declares only what
  is genuinely its own.

  RECORD_AUDIO is here rather than in the SDK because it is a runtime permission
  the app must request and justify to the user.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Android 11+ package visibility. Without this, queryIntentServices()
      silently returns an empty list and plugin discovery finds nothing —
      the app is only allowed to see packages it declares an interest in.
      Scoped to the plugin action specifically, not <queries> for all
      packages, so Jarvis can see plugins and nothing else.
    -->
    <queries>
        <!--
          One generic action covers every plugin, of any capability type —
          the type is metadata, so a new capability needs no change here.
          Android gives no wildcard for package visibility, so naming one
          action at build time is the furthest this can be generalised.
        -->
        <intent>
            <action android:name="com.s2s.plugin.action.PLUGIN" />
        </intent>
        <!-- Earlier per-capability actions, so already-installed plugins remain visible. -->
        <intent>
            <action android:name="com.s2s.plugin.action.TOOL_PLUGIN" />
        </intent>
        <intent>
            <action android:name="com.s2s.plugin.action.TEXT_NORMALIZER_PLUGIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="S2S Demo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TtsTestActivity"
            android:exported="false"
            android:label="TTS Voice Tester"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SttTestActivity"
            android:exported="false"
            android:label="STT Model Tester"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HuggingFaceBrowserActivity"
            android:exported="false"
            android:label="Hugging Face Models"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AgentChatTestActivity"
            android:exported="false"
            android:label="Agent Tool-Calling Tester"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PluginsActivity"
            android:exported="false"
            android:label="Plugins"
            android:screenOrientation="portrait" />
    </application>

</manifest>
