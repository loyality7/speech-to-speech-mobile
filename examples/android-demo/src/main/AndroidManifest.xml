<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal: everything the SDK needs — the download service, the
  voice-session service, and the INTERNET / FOREGROUND_SERVICE / POST_NOTIFICATIONS
  permissions — merges in from the SDK's own manifest. This app declares only what
  is genuinely its own.

  RECORD_AUDIO is here rather than in the SDK because it is a runtime permission
  the app must request and justify to the user.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="S2S Demo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TtsTestActivity"
            android:exported="false"
            android:label="TTS Voice Tester"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SttTestActivity"
            android:exported="false"
            android:label="STT Model Tester"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HuggingFaceBrowserActivity"
            android:exported="false"
            android:label="Hugging Face Models"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AgentChatTestActivity"
            android:exported="false"
            android:label="Agent Tool-Calling Tester"
            android:screenOrientation="portrait" />
    </application>

</manifest>
